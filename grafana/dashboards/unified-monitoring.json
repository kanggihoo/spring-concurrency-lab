  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "k6 - Virtual Users (VUs)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "k6_vus", "legendFormat": "Virtual Users" }
      ],
      "datasource": "Prometheus"
    },
    {
      "title": "k6 - Transactions Per Second (TPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(irate(k6_http_reqs_total[1m]))", "legendFormat": "TPS" }
      ],
      "datasource": "Prometheus"
    },
    {
      "title": "Spring Boot - HikariCP Connection Pool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "hikaricp_connections_active", "legendFormat": "Active Connections" },
        { "expr": "hikaricp_connections_max", "legendFormat": "Max Connections" }
      ],
      "datasource": "Prometheus"
    },
    {
      "title": "PostgreSQL - Active Sessions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "pg_stat_activity_count", "legendFormat": "Active Sessions" }
      ],
      "datasource": "Prometheus"
    },
    {
      "title": "App - Average Request Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_sum[1m])) / sum(rate(http_server_requests_seconds_count[1m]))", "legendFormat": "Avg Latency (seconds)" }
      ],
      "datasource": "Prometheus"
    }
  ],
